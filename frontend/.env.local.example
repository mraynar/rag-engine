# Secure Next.js API Route proxy path (hides backend host/port from browser DevTools)
NEXT_PUBLIC_API_URL=/api/proxy

# Base URL for deep-links (e.g. for Copy Token action)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Supabase Auth Client Credentials (Safe for client-side exposition)
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT_REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
